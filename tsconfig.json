{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,

    "baseUrl": ".",
    "paths": {
      "@assets":    ["src/assets"],    // <– добавлено
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@/*": ["src/*"]
    },

    "types": ["vite-plugin-svgr/client"],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
